; Un paseo por la Plaza de Armas (ver main.gd). La maqueta, juego/plaza.glb, sale de `make juego`.
config_version=5

[application]
config/name="Talca: paseo por la Plaza de Armas"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2

[shader_globals]

noche={
"type": "float",
"value": 0.0
}
sol_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
luna_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
